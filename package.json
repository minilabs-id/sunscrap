{
  "name": "sunscrap",
  "productName": "sunscrap",
  "version": "1.0.0",
  "description": "Audit engagement Instagram & TikTok berulang — aplikasi desktop lokal, tanpa API berbayar.",
  "main": "src/main/main.js",
  "author": "sunscrap",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/startupmini/sunscrap.git"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node --test \"src/test/**/*.test.js\"",
    "e2e": "node scripts/e2e.js",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:dir": "electron-builder --win dir",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.48.2"
  },
  "build": {
    "appId": "com.sunscrap.app",
    "productName": "sunscrap",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "startupmini",
      "repo": "sunscrap",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "sunscrap-setup-${version}.${ext}",
      "differentialPackage": true
    },
    "portable": {
      "artifactName": "sunscrap-portable-${version}.${ext}"
    }
  }
}
