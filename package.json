{
  "name": "sunscraping",
  "productName": "sunscraping",
  "version": "1.0.0",
  "description": "Audit engagement Instagram & TikTok berulang — aplikasi desktop lokal, tanpa API berbayar.",
  "main": "src/main/main.js",
  "author": "sunscraping",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test src/test/",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sunscraping.desktop",
    "productName": "sunscraping",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "sunscraping-setup-${version}.${ext}"
    }
  }
}